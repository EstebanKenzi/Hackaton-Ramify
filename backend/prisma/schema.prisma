generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id                Int      @id @default(autoincrement())
  nom               String
  marque            String
  materiaux         String
  origine           String
  scoreConformite   Float
  qrCodeUrl         String?
  txHashBlockchain  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
